# ── chatglm.cn 最小反代 配置 ──
# 复制本文件为 .env 后按需修改

# 上游域名。默认对应网页版接口，不建议改。
GLM_BASE_URL=https://chatglm.cn/chatglm

# 你的 refresh_token（留空则自动走游客模式）
# 获取方式见 README：浏览器 F12 → Application → Local Storage → chatglm_refresh_token
GLM_REFRESH_TOKEN=

# 多账号（可选）：逗号/分号/换行分隔。账号之间可以并行，撞闸或失效会自动轮换。
# 单账号请忽略此项；两个都填会合并去重（GLM_REFRESH_TOKEN 排在最前）。
GLM_REFRESH_TOKENS=

# 强制走游客模式（忽略上面的 token）
GLM_USE_GUEST=false

# 所有账号都失效时，是否临时退回游客账号兜底（false = 直接返回 401）
GLM_GUEST_FALLBACK=true

# ─ 并发治理 ──
# 上游对同一账号有并发闸：同时只允许一个对话生成。
# 本项目按账号串行排队 + 撞闸退避重试，下面的参数控制等待与重试策略。
# 本地排队最多等多久（秒）；超时返回 503 queue_timeout
GLM_QUEUE_TIMEOUT=180
# 撞上游并发闸（或 429/5xx）后的重试次数
GLM_BUSY_RETRIES=3
# 退避基数（秒），实际等待 = base * 2^attempt，上限 30s
GLM_BUSY_BACKOFF=3
# 账号鉴权彻底失效后的冷却秒数（期间该账号不再被调度）
GLM_ACCOUNT_COOLDOWN=300

# ─ refresh_token 落盘 ──
# 上游会轮换 refresh_token，开启后写入下面的文件，重启不会再用回 .env 里的旧值
GLM_PERSIST_TOKENS=true
GLM_TOKEN_FILE=.glm_tokens.json

# ─ 能力开关 ──
# 是否默认开启联网搜索（也可以用请求体 {"glm": {"networking": true}} 单次覆盖）
GLM_NETWORKING=false

# 工具调用（function calling）。网页版接口没有原生 function calling，
# 本代理用「提示词描述工具 + 解析模型 JSON 输出」模拟成 OpenAI 的 tool_calls，
# 工具真正由你的客户端执行。默认开启（客户端发了 tools 就用；解析不出来会退化成普通回答）。
# 代价：带 tools 的请求会缓冲整段输出（不逐字流式）。
# 设为 false 可恢复旧行为（忽略客户端 tools，只当普通对话）。
GLM_PROMPT_TOOL_CALLING=true

# 「思考泄漏」自愈（默认 2 次，设 0 关闭）
# 实测：工具链里模型会只输出「我接下来打算干什么」的碎碎念就结束生成，
# 或者干脆什么都不输出（客户端收到空回答）。用户看到的既不是工具调用也不是回答。
# 三种形态都会拦：碎碎念跑进正文 / 正文空而思维链在自言自语 / 正文与思维链都空。
# 命中时代理自动续问，逼它给出真正的结论。
GLM_TOOL_CONTINUE_TRIES=2

# ─ 工具结果体积治理（默认开启，建议保持）──
# 实测事故：一次网页抓取回灌 74000 字，加上工具列表与多轮搜索结果，峰值 prompt
# 达 92967 字。上下文被网页垃圾填满后，模型「看不见用户原始问题」，只在垃圾堆里
# 打转，最后答非所问（例如明明能查却答「查不到实时客流」）。
# 下面三个值控制裁剪力度：单条上限 / 累计上限 / 网页类额外上限（更小）。
# 裁剪保留头尾并标注省略量，不会把工具结果整条丢掉。
GLM_CLAMP_TOOL_RESULT=true
GLM_TOOL_RESULT_MAX_CHARS=8000
GLM_TOOL_RESULT_TOTAL_MAX_CHARS=20000
GLM_WEB_RESULT_MAX_CHARS=4000

# 对外暴露的模型名清单（逗号分隔），只影响 GET /v1/models 和客户端下拉框。
# 客户端选的模型名会写进上游请求的 meta_data.selected_model，能真的切换上游模型：
#   glm-5.3 → moe_53，glm-5/glm-4.7 → moe_52，glm-4.x → moe_53f（实测）
GLM_MODELS=glm-4,glm-4-flash,glm-4-air,glm-4.6,glm-4.7,glm-5,glm-5.3

# 是否把客户端 model 名写进 meta_data.selected_model（默认开）。实测这是真正切换上游
# 模型的字段；设为 false 则所有模型名都落回上游默认档（moe_53f）。
GLM_SELECTED_MODEL=true

# 「深度思考」模式（默认关闭）。
# 上游网页版要开深度思考，需要同时下发 meta_data.chat_mode=deep_thinking 与
# reasoning_effort（少任何一个上游都不认）。不开发思考时上游默认档只会把任务
# 复述一遍，不会真的推理。
#
# 全局默认（false = 每次都要在请求体里显式开；true = 默认全开，请求体可单次关掉）：
GLM_DEEP_THINKING=false
# 下面两个是老写法（仍然有效；显式配了就以它们为准，按请求开深度思考也不覆盖）：
GLM_CHAT_MODE=
GLM_REASONING_EFFORT=
# 也可以不配全局，按请求单次开/关（推荐，不用重启）：
#   请求体 {"glm":{"deep_thinking":true}}  也认 {"glm_deep_thinking":true} / {"deep_thinking":true}
#   Anthropic /v1/messages 发 {"thinking":{"type":"enabled"}} 即视为要深度思考
# 注意：深度思考明显变慢，长问题可能顶到 GLM_QUEUE_TIMEOUT（默认 180s）

# 是否发送 if_plus_model=true（历史行为，默认保留；真实网页请求不带该字段）
GLM_IF_PLUS_MODEL=true

# ─ Anthropic Messages API（/v1/messages）──
# 默认开启。请求带 thinking 参数时，除了把上游思维链输出成 Anthropic 的 thinking block，
# 还会让上游切到深度思考档（chat_mode=deep_thinking + reasoning_effort=max）。
# 上游不提供真正的 signature，本代理只给占位值；若客户端严格校验 signature 而报错，
# 设为 false 关掉（思维链被丢弃，不会混进正文）。
ANTHROPIC_EMIT_THINKING=true

# 「模型名 → assistant_id」映射（可选）。填了之后，客户端选不同模型名会真的走不同上游助手。
# 格式：模型名=24位assistant_id（逗号分隔，键不分大小写，= 或 : 都行）
# 不知道目标模型的 assistant_id？网页版切到该模型 → F12 → Network → 看
# /chatglm/backend-api/assistant/stream 请求体里的 assistant_id，填到这里即可。
GLM_MODEL_ASSISTANT_MAP=

# 普通对话用的 assistant_id，保持默认即可
GLM_ASSISTANT_ID=65940acff94777010aa6b796

# 上游请求超时（秒）。长回答/联网场景建议给足
GLM_TIMEOUT=180

# 是否在每次回答后删除上游会话记录（保持网页端干净）
GLM_DELETE_CONVERSATION=true

# ─ 本地服务 ──
HOST=127.0.0.1
PORT=8000

# 本地访问鉴权（可选）。留空 = 不校验；填了则请求需带 Authorization: Bearer <key>
SERVER_API_KEYS=

# 打印每次 HTTP 访问日志
GLM_VERBOSE=false